# Managed by Ansible - do not edit by hand
server {
    listen {{ nginx_listen_port }} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Served-By "{{ inventory_hostname }}" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Simple endpoint for the Week 3 health checker
    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
}